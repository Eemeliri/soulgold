raw `
BattleCafe_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, BattleCafe_OnTransition
	.byte 0
`

script BattleCafe_OnTransition {
    setflag(FLAG_HIDE_BATTLE_CAFE_OPPONENT)
    setflag(FLAG_VISITED_ROUTE50)
    end
}

script BattleCafe_Owner {
    lock
    faceplayer

    if (!flag(FLAG_BATTLE_CAFE_DIANCIE_RECEIVED)
        && defeated(TRAINER_CAFE_ATHENA)
        && defeated(TRAINER_CAFE_DOVES)
        && defeated(TRAINER_CAFE_ELTON)
        && defeated(TRAINER_CAFE_NEM)
        && defeated(TRAINER_CAFE_BAI)
        && defeated(TRAINER_CAFE_DRAC)
        && defeated(TRAINER_CAFE_JUNA)
        && defeated(TRAINER_CAFE_TYLARIE)) {
        goto(BattleCafe_GiveDiancie)
    }
    goto(BattleCafe_OwnerMenu)
}

script BattleCafe_GiveDiancie {
    if (!flag(FLAG_BATTLE_CAFE_DIANCIE_READY)) {
        msgbox("Well, look at that. You've beaten
                every one of my regulars at least
                once.

                Seems only right you leave with a
                rare dining companion, Diancie!")
        msgbox("It'll be waiting right here. Make
                whatever preparations you need, then
                come talk to me when you're ready to
                welcome it aboard.")
        setflag(FLAG_BATTLE_CAFE_DIANCIE_READY)
        release
        end
    }

    msgbox("Diancie is waiting for you.

            Are you ready to receive it?",
           MSGBOX_YESNO)
    if (var(VAR_RESULT) != YES) {
        msgbox("No rush. Diancie will be right
                here whenever you're ready.")
        goto(BattleCafe_OwnerMenu)
    }

    setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_DIANCIE)
    bufferspeciesname(STR_VAR_1, SPECIES_DIANCIE)
    givemon(SPECIES_DIANCIE, 70)
    if (var(VAR_RESULT) == MON_CANT_GIVE) {
        goto(Common_EventScript_NoMoreRoomForPokemon)
    }
    showgivemonpic(10, 3)
    call(Common_EventScript_GiftMon)
    hidemonpic
    clearflag(FLAG_BATTLE_CAFE_DIANCIE_READY)
    setflag(FLAG_BATTLE_CAFE_DIANCIE_RECEIVED)
    msgbox("Diancie's a fine addition to the menu.
            Take good care of it!")
    goto(BattleCafe_OwnerMenu)
}

script BattleCafe_OwnerMenu {
    if (!flag(FLAG_CAFE_INTRO_DONE)) {
        msgbox("Welcome to my Battle Café!

        I picked up my recipes and my battling
        chops back home in Galar.

        These days I bring Trainers together
        for good food and good battles, right
        here in Johto.

        There's even a special prize if you
        manage to beat all the regulars here.

        However I must warn you that all the
        regulars here are really tough!

        Anyway, enough about me...")
        setflag(FLAG_CAFE_INTRO_DONE)
    }

    if (!flag(FLAG_BATTLE_CAFE_ENDLESS_CHALLENGE_UNLOCKED)
        && flag(FLAG_DAILY_BATTLE_CAFE_SUPER_CHALLENGE_WON)) {
        msgbox("After seeing you clear Super Challenge,
                I can offer you a new format:

                Endless Challenge!")
        setflag(FLAG_BATTLE_CAFE_ENDLESS_CHALLENGE_UNLOCKED)
    }
    if (!flag(FLAG_BATTLE_CAFE_ENDLESS_RUSH_UNLOCKED)
        && flag(FLAG_DAILY_BATTLE_CAFE_SUPER_RUSH_WON)) {
        msgbox("After seeing you conquer Super Rush,
                I can offer you one final format:

                Endless Rush!")
        setflag(FLAG_BATTLE_CAFE_ENDLESS_RUSH_UNLOCKED)
    }

    msgbox("Welcome! What'll it be today?")
    if (flag(FLAG_BATTLE_CAFE_ENDLESS_CHALLENGE_UNLOCKED)
        || flag(FLAG_BATTLE_CAFE_ENDLESS_RUSH_UNLOCKED)) {
        dynmultichoice(0, 0, FALSE, 6, 0, DYN_MULTICHOICE_CB_NONE,
                       "Daily Challenge",
                       "Rush Mode",
                       "Super Challenge",
                       "Super Rush",
                       "Endless Modes",
                       "Exchange Points",
                       "Café Options",
                       "Leave")
        switch (var(VAR_RESULT)) {
            case 0: goto(BattleCafe_AskDailyChallenge)
            case 1: goto(BattleCafe_AskRushMode)
            case 2: goto(BattleCafe_AskSuperChallenge)
            case 3: goto(BattleCafe_AskSuperRush)
            case 4: goto(BattleCafe_EndlessMenu)
            case 5: goto(BattleCafe_RewardMenu)
            case 6: goto(BattleCafe_OptionsMenu)
            default: goto(BattleCafe_Goodbye)
        }
    }

    dynmultichoice(0, 0, FALSE, 6, 0, DYN_MULTICHOICE_CB_NONE,
                   "Daily Challenge",
                   "Rush Mode",
                   "Super Challenge",
                   "Super Rush",
                   "Exchange Points",
                   "Café Options",
                   "Leave")
    switch (var(VAR_RESULT)) {
        case 0: goto(BattleCafe_AskDailyChallenge)
        case 1: goto(BattleCafe_AskRushMode)
        case 2: goto(BattleCafe_AskSuperChallenge)
        case 3: goto(BattleCafe_AskSuperRush)
        case 4: goto(BattleCafe_RewardMenu)
        case 5: goto(BattleCafe_OptionsMenu)
        default: goto(BattleCafe_Goodbye)
    }
}

script BattleCafe_OptionsMenu {
    msgbox("What would you like to check?")
    dynmultichoice(0, 0, FALSE, 6, 0, DYN_MULTICHOICE_CB_NONE,
                   "Battle BGM",
                   "High Scores",
                   "Innates",
                   "Café Rules",
                   "Back")
    switch (var(VAR_RESULT)) {
        case 0: goto(BattleCafe_ChooseBattleBgm)
        case 1: goto(BattleCafe_ViewHighScores)
        case 2: goto(BattleCafe_ChooseInnates)
        case 3: goto(BattleCafe_ExplainRules)
        default: goto(BattleCafe_OwnerMenu)
    }
}

script BattleCafe_ChooseBattleBgm {
    call(BattleFrontier_EventScript_ChooseBattleBgm)
    goto(BattleCafe_OwnerMenu)
}

script BattleCafe_ViewHighScores {
    closemessage
    special(BattleCafe_ShowRecordsWindow)
    waitbuttonpress
    special(RemoveRecordsWindow)
    goto(BattleCafe_OwnerMenu)
}

script BattleCafe_ChooseInnates {
    call(BattleFrontier_EventScript_ChooseInnates)
    goto(BattleCafe_OptionsMenu)
}

script BattleCafe_ExplainRules {
    msgbox("Three Café visitors will answer each
            challenge, one after another.

            In the Daily Challenge, they bring
            dependable teams of four.

            I'll tend to your Pokémon after each
            battle.

            Win all three for 3 Café Points.")
    msgbox("Rush Mode draws seasoned battlers with
            teams of four.

            Anything goes, and I can't heal
            your Pokémon between the matches.

            Win all three for 5 points.")
    msgbox("Super Challenge and Super Rush pit
            you against full teams of six Pokémon.

            Anyone might show up so prepare to
            face literally anything.

            Same rules apply here for healing
            between the rounds.")
    msgbox("There are no breaks once service
            begins.

            A loss ends the run, though
            you may retry until you win.

            Each challenge can be won once per day.")
    if (flag(FLAG_BATTLE_CAFE_ENDLESS_CHALLENGE_UNLOCKED)
        || flag(FLAG_BATTLE_CAFE_ENDLESS_RUSH_UNLOCKED)) {
        msgbox("Both Endless formats use full teams
                of six and continue until you lose
                or choose to retire.

                Endless Challenge heals your party
                after every win and awards 1 point.")
        msgbox("Endless Rush restores your party
                after every third victory and awards
                2 points per win.

                Your best streak in each format is
                saved under High Scores.")
    }
    goto(BattleCafe_OwnerMenu)
}

script BattleCafe_AskDailyChallenge {
    if (flag(FLAG_DAILY_BATTLE_CAFE_CHALLENGE_WON)) {
        msgbox("You've already cleared today's
                Daily Challenge.

                Come back tomorrow,
                or try another challenge!")
        goto(BattleCafe_OwnerMenu)
    }
    msgbox("Three Café visitors are ready with
            teams of four.

            I'll tend to your party
            after rounds one and two.

            Begin today's challenge?", MSGBOX_YESNO)
    if (var(VAR_RESULT) != YES) {
        goto(BattleCafe_OwnerMenu)
    }
    setvar(VAR_TEMP_8, BATTLE_CAFE_MODE_DAILY)
    goto(BattleCafe_BeginChallenge)
}

script BattleCafe_AskRushMode {
    if (flag(FLAG_DAILY_BATTLE_CAFE_RUSH_WON)) {
        msgbox("You've already conquered Rush Mode
                today.

                Come back tomorrow, or take
                another challenge!")
        goto(BattleCafe_OwnerMenu)
    }
    msgbox("Three seasoned visitors are waiting
            with teams of four.

            I can't tend to your party between 
            these battles.

            Begin today's rush?", MSGBOX_YESNO)
    if (var(VAR_RESULT) != YES) {
        goto(BattleCafe_OwnerMenu)
    }
    setvar(VAR_TEMP_8, BATTLE_CAFE_MODE_RUSH)
    goto(BattleCafe_BeginChallenge)
}

script BattleCafe_AskSuperChallenge {
    if (flag(FLAG_DAILY_BATTLE_CAFE_SUPER_CHALLENGE_WON)) {
        msgbox("You've already cleared today's
                Super Challenge.

                Come back tomorrow,
                or attempt another challenge!")
        goto(BattleCafe_OwnerMenu)
    }
    specialvar(VAR_RESULT, CountPartyNonEggMons)
    if (var(VAR_RESULT) < PARTY_SIZE) {
        msgbox("Every Pokémon gets a seat in Super
                Challenge. Bring a full party of six
                before entering.")
        goto(BattleCafe_OwnerMenu)
    }
    msgbox("Three visitors will each meet your full
            party with six Pokémon of their own.

            I'll tend to your team between battles.

            Begin the Super Challenge?", MSGBOX_YESNO)
    if (var(VAR_RESULT) != YES) {
        goto(BattleCafe_OwnerMenu)
    }
    setvar(VAR_TEMP_8, BATTLE_CAFE_MODE_SUPER_CHALLENGE)
    goto(BattleCafe_BeginChallenge)
}

script BattleCafe_AskSuperRush {
    if (flag(FLAG_DAILY_BATTLE_CAFE_SUPER_RUSH_WON)) {
        msgbox("You've already conquered Super Rush
                today.

                Come back tomorrow for
                another full-team trial!")
        goto(BattleCafe_OwnerMenu)
    }
    specialvar(VAR_RESULT, CountPartyNonEggMons)
    if (var(VAR_RESULT) < PARTY_SIZE) {
        msgbox("Every Pokémon gets a seat in Super
                Rush.

                Bring a full party of six
                before entering.")
        goto(BattleCafe_OwnerMenu)
    }
    msgbox("Three visitors will each bring a full
            team of six.

            Once the rush begins, I can't heal
            your Pokémon between the battles.

            Begin the Super Rush?", MSGBOX_YESNO)
    if (var(VAR_RESULT) != YES) {
        goto(BattleCafe_OwnerMenu)
    }
    setvar(VAR_TEMP_8, BATTLE_CAFE_MODE_SUPER_RUSH)
    goto(BattleCafe_BeginChallenge)
}

script BattleCafe_EndlessMenu {
    msgbox("Which Endless format will you try?")
    dynmultichoice(0, 0, FALSE, 6, 0, DYN_MULTICHOICE_CB_NONE,
                   "Endless Challenge",
                   "Endless Rush",
                   "Endless Rules",
                   "Back")
    switch (var(VAR_RESULT)) {
        case 0: goto(BattleCafe_AskEndlessChallenge)
        case 1: goto(BattleCafe_AskEndlessRush)
        case 2: goto(BattleCafe_ExplainEndlessRules)
        default: goto(BattleCafe_OwnerMenu)
    }
}

script BattleCafe_ExplainEndlessRules {
    msgbox("Endless Challenge restores your party
            after every victory. 
            
            Each win immediately awards 1 
            Café Point.

            Clear Super Challenge to unlock it.")
    msgbox("Endless Rush restores your party after
            every third victory. 
            
            Each win immediately awards 2 
            Café Points.

            Clear Super Rush to unlock it.")
    msgbox("Both formats use full 6-vs-6 battles.
            You may retire after any victory,
            and your best streak is saved.")
    goto(BattleCafe_EndlessMenu)
}

script BattleCafe_AskEndlessChallenge {
    if (!flag(FLAG_BATTLE_CAFE_ENDLESS_CHALLENGE_UNLOCKED)) {
        msgbox("Clear Super Challenge to unlock
                Endless Challenge.")
        goto(BattleCafe_EndlessMenu)
    }
    specialvar(VAR_RESULT, CountPartyNonEggMons)
    if (var(VAR_RESULT) < PARTY_SIZE) {
        msgbox("Every Endless opponent brings
                six Pokémon.

                Bring a full party of six before
                taking your seat.")
        goto(BattleCafe_EndlessMenu)
    }
    msgbox("Full teams of six will keep coming
            until you lose or retire.

            I'll restore your party after every win,
            and each victory earns 1 Café Point.

            Begin Endless Challenge?", MSGBOX_YESNO)
    if (var(VAR_RESULT) != YES) {
        goto(BattleCafe_EndlessMenu)
    }
    setvar(VAR_TEMP_8, BATTLE_CAFE_MODE_ENDLESS_CHALLENGE)
    goto(BattleCafe_BeginChallenge)
}

script BattleCafe_AskEndlessRush {
    if (!flag(FLAG_BATTLE_CAFE_ENDLESS_RUSH_UNLOCKED)) {
        msgbox("Clear Super Rush to unlock
                Endless Rush.")
        goto(BattleCafe_EndlessMenu)
    }
    specialvar(VAR_RESULT, CountPartyNonEggMons)
    if (var(VAR_RESULT) < PARTY_SIZE) {
        msgbox("Every Endless opponent brings
                six Pokémon.

                Bring a full party of six before
                taking your seat.")
        goto(BattleCafe_EndlessMenu)
    }
    msgbox("Full teams of six will keep coming
            until you lose or retire.

            I'll restore your party after every third
            victory. Each win earns 2 Café Points.

            Begin Endless Rush?", MSGBOX_YESNO)
    if (var(VAR_RESULT) != YES) {
        goto(BattleCafe_EndlessMenu)
    }
    setvar(VAR_TEMP_8, BATTLE_CAFE_MODE_ENDLESS_RUSH)
    goto(BattleCafe_BeginChallenge)
}

script BattleCafe_BeginChallenge {
    closemessage
    hidefollower
    special(HealPlayerParty)
    special(BattleCafe_InitChallenge)
    moveobjecttocoords(LOCALID_PLAYER, 6, 13, DIR_EAST)
    waitmovement(0)
    setvar(VAR_TEMP_9, 0)
    setvar(VAR_TEMP_C, 0)
    if (var(VAR_TEMP_8) == BATTLE_CAFE_MODE_ENDLESS_CHALLENGE
        || var(VAR_TEMP_8) == BATTLE_CAFE_MODE_ENDLESS_RUSH) {
        msgbox("No final course. No final opponent.
                Endless service begins now!")
    } else {
        msgbox("Three courses. Three opponents.
                Service begins now!")
    }
    closemessage
    goto(BattleCafe_ChallengeNextRound)
}

script BattleCafe_ChallengeNextRound {
    call(BattleCafe_RunRound)
    if (var(VAR_RESULT) != TRUE) {
        goto(BattleCafe_ChallengeLost)
    }

    special(BattleCafe_AdvanceWinCount)
    if (var(VAR_TEMP_8) == BATTLE_CAFE_MODE_ENDLESS_CHALLENGE) {
        setvar(VAR_0x8004, 1)
        special(BattleCafe_AwardPoints)
        copyvar(VAR_TEMP_B, VAR_RESULT)
        special(HealPlayerParty)
        playse(SE_SHOP)
        waitse
        buffernumberstring(STR_VAR_1, VAR_TEMP_9)
        buffernumberstring(STR_VAR_2, VAR_TEMP_B)
        msgbox("Victory! Streak: {STR_VAR_1}.
                You received {STR_VAR_2} Café Points,
                and your party was restored.

                Continue the run?", MSGBOX_YESNO)
        if (var(VAR_RESULT) != YES) {
            goto(BattleCafe_EndlessRetired)
        }
        closemessage
        goto(BattleCafe_ChallengeNextRound)
    }

    if (var(VAR_TEMP_8) == BATTLE_CAFE_MODE_ENDLESS_RUSH) {
        setvar(VAR_0x8004, 2)
        special(BattleCafe_AwardPoints)
        copyvar(VAR_TEMP_B, VAR_RESULT)
        addvar(VAR_TEMP_C, 1)
        playse(SE_SHOP)
        waitse
        buffernumberstring(STR_VAR_1, VAR_TEMP_9)
        buffernumberstring(STR_VAR_2, VAR_TEMP_B)
        if (var(VAR_TEMP_C) >= 3) {
            setvar(VAR_TEMP_C, 0)
            special(HealPlayerParty)
            playse(SE_USE_ITEM)
            msgbox("Victory! Streak: {STR_VAR_1}.
                    You received {STR_VAR_2} Café Points.

                    Three battles cleared! Your party
                    was restored. Continue the run?", MSGBOX_YESNO)
        } else {
            msgbox("Victory! Streak: {STR_VAR_1}.
                    You received {STR_VAR_2} Café Points.

                    Your party has not been restored.
                    Continue the run?", MSGBOX_YESNO)
        }
        if (var(VAR_RESULT) != YES) {
            goto(BattleCafe_EndlessRetired)
        }
        closemessage
        goto(BattleCafe_ChallengeNextRound)
    }

    if (var(VAR_TEMP_9) >= 3) {
        goto(BattleCafe_ChallengeWon)
    }

    if (var(VAR_TEMP_8) == BATTLE_CAFE_MODE_DAILY) {
        special(HealPlayerParty)
        playse(SE_USE_ITEM)
        msgbox("Your party was restored.
                The next challenger is arriving!")
    } else {
        if (var(VAR_TEMP_8) == BATTLE_CAFE_MODE_SUPER_CHALLENGE) {
            special(HealPlayerParty)
            playse(SE_USE_ITEM)
            msgbox("Your party was restored.
                    The next full team is arriving!")
        } else {
            if (var(VAR_TEMP_8) == BATTLE_CAFE_MODE_SUPER_RUSH) {
                msgbox("No healing in Super Rush!
                        The next full team is arriving!")
            } else {
                msgbox("No healing in Rush Mode!
                        The next challenger is arriving!")
            }
        }
    }
    closemessage
    goto(BattleCafe_ChallengeNextRound)
}

script BattleCafe_EndlessRetired {
    closemessage
    special(BattleCafe_EndChallenge)
    special(HealPlayerParty)
    moveobjecttocoords(LOCALID_PLAYER, 6, 24, DIR_NORTH)
    waitmovement(0)
    turnobject(LOCALID_CAFE_OWNER, DIR_SOUTH)
    buffernumberstring(STR_VAR_1, VAR_TEMP_9)
    msgbox("Run retired at {STR_VAR_1} wins.

            Your party is fully restored, your record
            is safe, and every point is yours to keep.")
    goto(BattleCafe_OwnerMenu)
}

script BattleCafe_RunRound {
    copyvar(VAR_0x8004, VAR_TEMP_9)
    special(BattleCafe_SelectOpponent)
    setobjectxy(LOCALID_BATTLE_CAFE_OPPONENT, 14, 17)
    addobject(LOCALID_BATTLE_CAFE_OPPONENT)
    moveobjecttocoords(LOCALID_BATTLE_CAFE_OPPONENT, 10, 13, DIR_WEST)
    waitmovement(0)
    tower_getopponentintro(FRONTIER_BEFORE_TEXT)
    msgbox(gStringVar4)
    closemessage
    dofacilitytrainerbattle(FACILITY_BATTLE_CAFE)
    waitstate
    frontier_get(FRONTIER_DATA_BATTLE_OUTCOME)
    copyvar(VAR_TEMP_A, VAR_RESULT)

    moveobjecttocoords(LOCALID_BATTLE_CAFE_OPPONENT, 14, 17, DIR_EAST)
    waitmovement(0)
    removeobject(LOCALID_BATTLE_CAFE_OPPONENT)

    if (var(VAR_TEMP_A) == B_OUTCOME_WON) {
        setvar(VAR_RESULT, TRUE)
    } else {
        setvar(VAR_RESULT, FALSE)
    }
    return
}

script BattleCafe_ChallengeLost {
    special(BattleCafe_EndChallenge)
    special(HealPlayerParty)
    moveobjecttocoords(LOCALID_PLAYER, 6, 24, DIR_NORTH)
    waitmovement(0)
    turnobject(LOCALID_CAFE_OWNER, DIR_SOUTH)
    if (var(VAR_TEMP_8) == BATTLE_CAFE_MODE_ENDLESS_CHALLENGE
        || var(VAR_TEMP_8) == BATTLE_CAFE_MODE_ENDLESS_RUSH) {
        buffernumberstring(STR_VAR_1, VAR_TEMP_9)
        msgbox("Your Endless run ends at {STR_VAR_1}
                wins. I've fully
                restored your party.

                Every Café Point you earned is yours
                to keep. Try to push even farther
                next time!")
    } else {
        msgbox("Tough course, huh? I've fully restored
                your party.

                Catch your breath, rework
                your strategy, and come at it again
                whenever you like!")
    }
    goto(BattleCafe_OwnerMenu)
}

script BattleCafe_ChallengeWon {
    special(BattleCafe_EndChallenge)
    special(HealPlayerParty)
    moveobjecttocoords(LOCALID_PLAYER, 6, 24, DIR_NORTH)
    waitmovement(0)
    turnobject(LOCALID_CAFE_OWNER, DIR_SOUTH)

    if (var(VAR_TEMP_8) == BATTLE_CAFE_MODE_DAILY) {
        setflag(FLAG_DAILY_BATTLE_CAFE_CHALLENGE_WON)
        setvar(VAR_0x8004, 3)
        special(BattleCafe_AwardPoints)
        copyvar(VAR_TEMP_B, VAR_RESULT)
        buffernumberstring(STR_VAR_1, VAR_TEMP_B)
        msgbox("Daily Challenge complete!

                That's {STR_VAR_1} Café Points for you.")
    } else {
        if (var(VAR_TEMP_8) == BATTLE_CAFE_MODE_RUSH) {
            setflag(FLAG_DAILY_BATTLE_CAFE_RUSH_WON)
            setvar(VAR_0x8004, 5)
            special(BattleCafe_AwardPoints)
            copyvar(VAR_TEMP_B, VAR_RESULT)
            buffernumberstring(STR_VAR_1, VAR_TEMP_B)
            msgbox("Rush Mode complete! That took
                    some real grit.

                    Here's {STR_VAR_1} Café Points.")
        } else {
            if (var(VAR_TEMP_8) == BATTLE_CAFE_MODE_SUPER_CHALLENGE) {
                setflag(FLAG_DAILY_BATTLE_CAFE_SUPER_CHALLENGE_WON)
                setvar(VAR_0x8004, 5)
                special(BattleCafe_AwardPoints)
                copyvar(VAR_TEMP_B, VAR_RESULT)
                buffernumberstring(STR_VAR_1, VAR_TEMP_B)
                msgbox("Super Challenge complete!
                        Full team, full effort!

                        That's {STR_VAR_1} Café Points.")
            } else {
                setflag(FLAG_DAILY_BATTLE_CAFE_SUPER_RUSH_WON)
                setvar(VAR_0x8004, 10)
                special(BattleCafe_AwardPoints)
                copyvar(VAR_TEMP_B, VAR_RESULT)
                buffernumberstring(STR_VAR_1, VAR_TEMP_B)
                msgbox("Incredible! You have beaten
                        the Super Rush mode!

                        I can hardly believe it!

                        Here's your reward of
                        {STR_VAR_1} Café Points.")
            }
        }
    }
    special(BattleCafe_UnlockClearAchievement)
    playse(SE_SHOP)
    waitse
    goto(BattleCafe_OwnerMenu)
}

script BattleCafe_RewardMenu {
    buffernumberstring(STR_VAR_1, VAR_BATTLE_CAFE_POINTS)
    msgbox("You have {STR_VAR_1} Café Points.
            Anything you want to exchange for?")
    special(BattleCafe_GetParadoxRewardEligibility)
    copyvar(VAR_TEMP_C, VAR_RESULT)
    dynmultipush("Vitamin Set Atk - 4", 10)
    dynmultipush("Vitamin Set Def - 4", 11)
    dynmultipush("Vitamin Set Spe - 2", 12)
    dynmultipush("Shiny Genome - 4", 7)
    dynmultipush("2 Gold Caps - 5", 8)
    dynmultipush("¥250,000 - 5", 9)
    dynmultipush("G. Articuno - 5", 0)
    dynmultipush("G. Zapdos - 5", 1)
    dynmultipush("G. Moltres - 5", 2)
    dynmultipush("Tornadus - 5", 3)
    dynmultipush("Thundurus - 5", 4)
    dynmultipush("Landorus - 5", 5)
    dynmultipush("Enamorus - 5", 6)
    dynmultipush("Tapu Koko - 5", 16)
    dynmultipush("Tapu Lele - 5", 17)
    dynmultipush("Tapu Bulu - 5", 18)
    dynmultipush("Tapu Fini - 5", 19)
    if (var(VAR_TEMP_C) == BATTLE_CAFE_PARADOX_REWARD_MIRAIDON
        || var(VAR_TEMP_C) == BATTLE_CAFE_PARADOX_REWARD_MIRAIDON + BATTLE_CAFE_PARADOX_REWARD_KORAIDON) {
        dynmultipush("Miraidon - 25", 13)
    }
    if (var(VAR_TEMP_C) == BATTLE_CAFE_PARADOX_REWARD_KORAIDON
        || var(VAR_TEMP_C) == BATTLE_CAFE_PARADOX_REWARD_MIRAIDON + BATTLE_CAFE_PARADOX_REWARD_KORAIDON) {
        dynmultipush("Koraidon - 25", 14)
    }
    dynmultipush("Back", 15)
    dynmultistack(0, 0, FALSE, 6, FALSE, 10, DYN_MULTICHOICE_CB_NONE)
    switch (var(VAR_RESULT)) {
        case 0: goto(BattleCafe_ChooseArticuno)
        case 1: goto(BattleCafe_ChooseZapdos)
        case 2: goto(BattleCafe_ChooseMoltres)
        case 3: goto(BattleCafe_ChooseTornadus)
        case 4: goto(BattleCafe_ChooseThundurus)
        case 5: goto(BattleCafe_ChooseLandorus)
        case 6: goto(BattleCafe_ChooseEnamorus)
        case 7: goto(BattleCafe_ChooseShinyGenome)
        case 8: goto(BattleCafe_ChooseGoldBottleCaps)
        case 9: goto(BattleCafe_ChooseMoney)
        case 10: goto(BattleCafe_ChooseVitaminSetAtk)
        case 11: goto(BattleCafe_ChooseVitaminSetDef)
        case 12: goto(BattleCafe_ChooseVitaminSetSpe)
        case 13: goto(BattleCafe_ChooseMiraidon)
        case 14: goto(BattleCafe_ChooseKoraidon)
        case 16: goto(BattleCafe_ChooseTapuKoko)
        case 17: goto(BattleCafe_ChooseTapuLele)
        case 18: goto(BattleCafe_ChooseTapuBulu)
        case 19: goto(BattleCafe_ChooseTapuFini)
        default: goto(BattleCafe_OwnerMenu)
    }
}

