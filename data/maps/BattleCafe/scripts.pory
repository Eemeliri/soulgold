    }
    setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_KORAIDON)
    setvar(VAR_TEMP_B, 1)
    goto(BattleCafe_ConfirmParadoxLegend)
}

script BattleCafe_ConfirmParadoxLegend {
    if (var(VAR_BATTLE_CAFE_POINTS) < 25) {
        goto(BattleCafe_NotEnoughLegendPoints)
    }
    bufferspeciesname(STR_VAR_1, VAR_TEMP_TRANSFERRED_SPECIES)
    msgbox("Exchange 25 Café Points for
            {STR_VAR_1}?", MSGBOX_YESNO)
    if (var(VAR_RESULT) != YES) {
        goto(BattleCafe_RewardMenu)
    }
    givemon(VAR_TEMP_TRANSFERRED_SPECIES, 70)
    if (var(VAR_RESULT) == MON_CANT_GIVE) {
        goto(Common_EventScript_NoMoreRoomForPokemon)
    }
    showgivemonpic(10, 3)
    call(Common_EventScript_GiftMon)
    hidemonpic
    subvar(VAR_BATTLE_CAFE_POINTS, 25)
    switch (var(VAR_TEMP_B)) {
        case 0: setflag(FLAG_BATTLE_CAFE_MIRAIDON_RECEIVED)
        case 1: setflag(FLAG_BATTLE_CAFE_KORAIDON_RECEIVED)
    }
    special(Achievement_CheckAll)
    msgbox("A rare specimen from Paldea. Take good
            care of it!")
    goto(BattleCafe_RewardMenu)
}

script BattleCafe_ChooseShinyGenome {
    if (var(VAR_BATTLE_CAFE_POINTS) < 4) {
        goto(BattleCafe_NotEnoughFourPoints)
    }
    msgbox("Exchange 4 Café Points for a
            Shiny Genome?", MSGBOX_YESNO)
    if (var(VAR_RESULT) != YES) {
        goto(BattleCafe_RewardMenu)
    }
    checkitemspace(ITEM_SHIN_GENOME, 1)
    if (var(VAR_RESULT) == FALSE) {
        goto(BattleCafe_NotEnoughBagSpace)
    }
    giveitem(ITEM_SHIN_GENOME)
    if (var(VAR_RESULT) != TRUE) {
        goto(BattleCafe_RewardMenu)
    }
    subvar(VAR_BATTLE_CAFE_POINTS, 4)
    msgbox("A rare find. Use it on whichever
            Pokémon you want to bring out the
            shine.")
    goto(BattleCafe_RewardMenu)
}

script BattleCafe_ChooseGoldBottleCaps {
    if (var(VAR_BATTLE_CAFE_POINTS) < 5) {
        goto(BattleCafe_NotEnoughPoints)
    }
    msgbox("Exchange 5 Café Points for two
            Gold Bottle Caps?", MSGBOX_YESNO)
    if (var(VAR_RESULT) != YES) {
        goto(BattleCafe_RewardMenu)
    }
    checkitemspace(ITEM_GOLD_BOTTLE_CAP, 2)
    if (var(VAR_RESULT) == FALSE) {
        goto(BattleCafe_NotEnoughBagSpace)
    }
    giveitem(ITEM_GOLD_BOTTLE_CAP, 2)
    if (var(VAR_RESULT) != TRUE) {
        goto(BattleCafe_RewardMenu)
    }
    subvar(VAR_BATTLE_CAFE_POINTS, 5)
    msgbox("Two Gold Bottle Caps, polished up and
            ready. Here you go!")
    goto(BattleCafe_RewardMenu)
}

script BattleCafe_ChooseMoney {
    if (var(VAR_BATTLE_CAFE_POINTS) < 5) {
        goto(BattleCafe_NotEnoughPoints)
    }
    msgbox("Exchange 5 Café Points for
            ¥250,000?", MSGBOX_YESNO)
    if (var(VAR_RESULT) != YES) {
        goto(BattleCafe_RewardMenu)
    }
    subvar(VAR_BATTLE_CAFE_POINTS, 5)
    showmoneybox(0, 0)
    addmoney(250000)
    updatemoneybox(0)
    playse(SE_SHOP)
    waitse
    hidemoneybox
    msgbox("Use it well, and perhaps spend a little
            on dessert!")
    goto(BattleCafe_RewardMenu)
}

script BattleCafe_ChooseVitaminSetAtk {
    if (var(VAR_BATTLE_CAFE_POINTS) < 4) {
        goto(BattleCafe_NotEnoughVitaminSetPoints)
    }
    msgbox("Exchange 4 Café Points for two each of
            Protein EX and Calcium EX?", MSGBOX_YESNO)
    if (var(VAR_RESULT) != YES) {
        goto(BattleCafe_RewardMenu)
    }
    setvar(VAR_0x8004, BATTLE_CAFE_VITAMIN_SET_ATK)
    special(BattleCafe_TryPurchaseVitaminSet)
    if (var(VAR_RESULT) == BATTLE_CAFE_VITAMIN_PURCHASE_NOT_ENOUGH_POINTS) {
        goto(BattleCafe_NotEnoughVitaminSetPoints)
    }
    if (var(VAR_RESULT) != BATTLE_CAFE_VITAMIN_PURCHASE_SUCCESS) {
        goto(BattleCafe_NotEnoughBagSpace)
    }
    playse(SE_SHOP)
    waitse
    msgbox("Two Protein EX and two Calcium EX,
            power and wisdom!")
    goto(BattleCafe_RewardMenu)
}

