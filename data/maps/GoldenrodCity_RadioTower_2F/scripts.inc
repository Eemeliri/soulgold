# 533 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
GoldenrodCity_RadioTower_2F_Text_GruntM4Seen:
# 534 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "Three years ago, Team Rocket was\n"
# 535 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "forced to disband.\p"
# 536 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "But we're making a comeback here!$"
# 537 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"

# 538 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
GoldenrodCity_RadioTower_2F_Text_GruntM4Beaten:
# 539 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "Gwah! Don't get cute!$"
# 540 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"

# 541 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
GoldenrodCity_RadioTower_2F_Text_GruntM4After:
# 542 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "We won't let you ruin our plans\n"
# 543 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "for our comeback!$"
# 544 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"

# 545 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
GoldenrodCity_RadioTower_2F_Text_GruntM5Seen:
# 546 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "We're Team Rocket, the exploiters\n"
# 547 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "of Pokémon!\p"
# 548 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "We love being evil! Scared?$"
# 549 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"

# 550 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
GoldenrodCity_RadioTower_2F_Text_GruntM5Beaten:
# 551 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "You think you're a hero?$"
# 552 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"

# 553 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
GoldenrodCity_RadioTower_2F_Text_GruntM5After:
# 554 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "We're not always evil. We just do\n"
# 555 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "whatever we like.$"
# 556 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"

# 557 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
GoldenrodCity_RadioTower_2F_Text_GruntM6Seen:
# 558 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "Hey, hey! Keep out of our way!$"
# 559 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"

# 560 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
GoldenrodCity_RadioTower_2F_Text_GruntM6Beaten:
# 561 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "Arggh. I give up.$"
# 562 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"

# 563 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
GoldenrodCity_RadioTower_2F_Text_GruntM6After:
# 564 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "Our Executives are trying to take\n"
# 565 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "this place over.\p"
# 566 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "They have some big plan. I wonder\n"
# 567 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "what that is?$"
# 568 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"

