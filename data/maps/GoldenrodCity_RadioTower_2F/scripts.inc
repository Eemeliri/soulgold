# 527 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"

# 528 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
GoldenrodCity_RadioTower_2F_Text_BlackBelt2:
# 529 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
