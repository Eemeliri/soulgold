GoldenrodCity_RadioTower_2F_Text_BlackBelt1:
# 522 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
	.string "Sorry. Authorized personnel only\n"
# 523 "data/maps/GoldenrodCity_RadioTower_2F/scripts.pory"
