	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaCheckAnswer

GoldenrodCity_RadioTower_2F_EventScript_BuenaAskTowns::
	dynmultichoice 0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerNewBarkTown, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerCherrygroveCity, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerAzaleaTown
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaCheckAnswer

GoldenrodCity_RadioTower_2F_EventScript_BuenaAskCategories::
	dynmultichoice 0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerBugPokemon, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerBirdPokemon, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerGrassPokemon
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaCheckAnswer

GoldenrodCity_RadioTower_2F_EventScript_BuenaAskMoves::
	dynmultichoice 0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerTackle, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerGrowl, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerMudSlap
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaCheckAnswer

GoldenrodCity_RadioTower_2F_EventScript_BuenaAskXItems::
	dynmultichoice 0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerXAttack, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerXDefend, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerXSpeed
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaCheckAnswer

GoldenrodCity_RadioTower_2F_EventScript_BuenaAskRadioShows::
	dynmultichoice 0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerPokemonTalk, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerPokemonMusic, GoldenrodCity_RadioTower_2F_Text_BuenaAnswerBuenasPassword
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaCheckAnswer

GoldenrodCity_RadioTower_2F_EventScript_BuenaCheckAnswer::
	goto_if_eq VAR_RESULT, MULTI_B_PRESSED, GoldenrodCity_RadioTower_2F_EventScript_BuenaDone
	specialvar VAR_0x8004, BuenasPassword_GetCorrectAnswer
	setflag FLAG_DAILY_BUENA_PASSWORD
	goto_if_eq VAR_RESULT, VAR_0x8004, GoldenrodCity_RadioTower_2F_EventScript_BuenaCorrect
	msgbox GoldenrodCity_RadioTower_2F_Text_BuenaWrong, MSGBOX_DEFAULT
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaDone

GoldenrodCity_RadioTower_2F_EventScript_BuenaCorrect::
	addvar VAR_BUENA_POINTS, 1
	addvar VAR_BUENA_PASSWORDS_CORRECT, 1
	special Achievement_CheckAll
	buffernumberstring STR_VAR_1, VAR_BUENA_POINTS
	turnobject LOCALID_BUENA, DIR_SOUTH
	playfanfare(MUS_OBTAIN_ITEM)
	msgbox GoldenrodCity_RadioTower_2F_Text_BuenaCorrect, MSGBOX_DEFAULT
	waitfanfare
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaDone

GoldenrodCity_RadioTower_2F_EventScript_BuenaOffAir::
	msgbox GoldenrodCity_RadioTower_2F_Text_BuenaOffAir, MSGBOX_DEFAULT
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaDone

GoldenrodCity_RadioTower_2F_EventScript_BuenaAlreadyPlayed::
	msgbox GoldenrodCity_RadioTower_2F_Text_BuenaAlreadyPlayed, MSGBOX_DEFAULT
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaDone

GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizes::
	buffernumberstring STR_VAR_1, VAR_BUENA_POINTS
	msgbox GoldenrodCity_RadioTower_2F_Text_BuenaPrizeIntro, MSGBOX_DEFAULT

GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeMenu::
	dynmultichoice 0, 0, FALSE, 6, 0, DYN_MULTICHOICE_CB_NONE, GoldenrodCity_RadioTower_2F_Text_BuenaPrizeQuickBall, GoldenrodCity_RadioTower_2F_Text_BuenaPrizeFullRestore, GoldenrodCity_RadioTower_2F_Text_BuenaPrizeElixir, GoldenrodCity_RadioTower_2F_Text_BuenaPrizeMaxElixir, GoldenrodCity_RadioTower_2F_Text_BuenaPrizeNugget, GoldenrodCity_RadioTower_2F_Text_BuenaPrizeExpCandyL, GoldenrodCity_RadioTower_2F_Text_BuenaPrizeEviolite, GoldenrodCity_RadioTower_2F_Text_BuenaPrizePPMax, GoldenrodCity_RadioTower_2F_Text_BuenaPrizeAbilityPatch, GoldenrodCity_RadioTower_2F_Text_BuenaMenuCancel
	switch VAR_RESULT
	case 0, GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeQuickBall
	case 1, GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeFullRestore
	case 2, GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeElixir
	case 3, GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeMaxElixir
	case 4, GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeNugget
	case 5, GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeExpCandyL
	case 6, GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeEviolite
	case 7, GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizePPMax
	case 8, GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeAbilityPatch
	case 9, GoldenrodCity_RadioTower_2F_EventScript_BuenaDone
	case MULTI_B_PRESSED, GoldenrodCity_RadioTower_2F_EventScript_BuenaDone
	end

GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeQuickBall::
	setvar VAR_0x8008, ITEM_QUICK_BALL
	setvar VAR_0x8009, 1
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaConfirmPrize

GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeFullRestore::
	setvar VAR_0x8008, ITEM_FULL_RESTORE
	setvar VAR_0x8009, 2
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaConfirmPrize

GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeElixir::
	setvar VAR_0x8008, ITEM_ELIXIR
	setvar VAR_0x8009, 2
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaConfirmPrize

GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeMaxElixir::
	setvar VAR_0x8008, ITEM_MAX_ELIXIR
	setvar VAR_0x8009, 3
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaConfirmPrize

GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeNugget::
	setvar VAR_0x8008, ITEM_NUGGET
	setvar VAR_0x8009, 3
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaConfirmPrize

GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeExpCandyL::
	setvar VAR_0x8008, ITEM_EXP_CANDY_L
	setvar VAR_0x8009, 4
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaConfirmPrize

GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeEviolite::
	setvar VAR_0x8008, ITEM_EVIOLITE
	setvar VAR_0x8009, 5
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaConfirmPrize

GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizePPMax::
	setvar VAR_0x8008, ITEM_PP_MAX
	setvar VAR_0x8009, 6
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaConfirmPrize

GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeAbilityPatch::
	setvar VAR_0x8008, ITEM_ABILITY_PATCH
	setvar VAR_0x8009, 7
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaConfirmPrize

GoldenrodCity_RadioTower_2F_EventScript_BuenaConfirmPrize::
	bufferitemname STR_VAR_1, VAR_0x8008
	buffernumberstring STR_VAR_2, VAR_0x8009
	msgbox GoldenrodCity_RadioTower_2F_Text_BuenaConfirmPrize, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeMenu
	goto_if_lt VAR_BUENA_POINTS, VAR_0x8009, GoldenrodCity_RadioTower_2F_EventScript_BuenaNotEnoughPoints
	checkitemspace VAR_0x8008
	goto_if_eq VAR_RESULT, FALSE, GoldenrodCity_RadioTower_2F_EventScript_BuenaBagFull
	giveitem VAR_0x8008
	goto_if_eq VAR_RESULT, FALSE, GoldenrodCity_RadioTower_2F_EventScript_BuenaBagFull
	subvar VAR_BUENA_POINTS, VAR_0x8009
	buffernumberstring STR_VAR_1, VAR_BUENA_POINTS
	msgbox GoldenrodCity_RadioTower_2F_Text_BuenaPrizeGiven, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeMenu
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaDone

GoldenrodCity_RadioTower_2F_EventScript_BuenaNotEnoughPoints::
	msgbox GoldenrodCity_RadioTower_2F_Text_BuenaNotEnoughPoints, MSGBOX_DEFAULT
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaPrizeMenu

GoldenrodCity_RadioTower_2F_EventScript_BuenaBagFull::
	msgbox GoldenrodCity_RadioTower_2F_Text_BuenaBagFull, MSGBOX_DEFAULT
	goto GoldenrodCity_RadioTower_2F_EventScript_BuenaDone

GoldenrodCity_RadioTower_2F_EventScript_BuenaDone::
	closemessage
	release
	end


GoldenrodCity_RadioTower_2F_EventScript_Teacher::
	lock
	faceplayer
	goto_if_eq VAR_GOLDENROD_CITY_STATE, 6, GoldenrodCity_RadioTower_2F_EventScript_Teacher2
	goto_if_eq VAR_GOLDENROD_CITY_STATE, 7, GoldenrodCity_RadioTower_2F_EventScript_Teacher2 
	goto_if_eq VAR_GOLDENROD_CITY_STATE, 8, GoldenrodCity_RadioTower_2F_EventScript_Teacher2 
	goto_if_eq VAR_GOLDENROD_CITY_STATE, 9, GoldenrodCity_RadioTower_2F_EventScript_Teacher2 
	msgbox GoldenrodCity_RadioTower_2F_Text_Teacher, MSGBOX_DEFAULT
	closemessage
	release
	end

GoldenrodCity_RadioTower_2F_EventScript_Teacher2::
	msgbox GoldenrodCity_RadioTower_2F_Text_TeacherRockets, MSGBOX_DEFAULT
	closemessage
	release
	end

GoldenrodCity_RadioTower_2F_EventScript_Jigglypuff::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_JIGGLYPUFF, CRY_MODE_NORMAL
	msgbox GoldenrodCity_RadioTower_2F_Text_Jigglypuff, MSGBOX_DEFAULT
	waitmoncry
	release
	end

RadioTower2FBuenaPasswordIsHelpText:
	.string "Buena: Today's password?\n"
	.string "Help, of course!$"

GoldenrodCity_RadioTower_2F_Text_BuenaGreeting:
	.string "Buena: Hi! This is the studio\n"
	.string "for Buena's Password.\p"
	.string "What can I do for you?$"

GoldenrodCity_RadioTower_2F_Text_BuenaMenuPassword:
	.string "Password$"

GoldenrodCity_RadioTower_2F_Text_BuenaMenuPrizes:
	.string "Prizes$"

GoldenrodCity_RadioTower_2F_Text_BuenaMenuCancel:
	.string "Cancel$"

GoldenrodCity_RadioTower_2F_Text_BuenaAskPassword:
	.string "Buena: Thank you for listening\n"
	.string "in every day!\p"
	.string "Do you remember today's\n"
	.string "password?$"

GoldenrodCity_RadioTower_2F_Text_BuenaForgotPassword:
	.string "Buena: Come back after you\n"
	.string "listen to my show, OK?\p"
	.string "Catch ya later!$"

GoldenrodCity_RadioTower_2F_Text_BuenaJoinShow:
	.string "Buena: Oh, wow! Thank you!\p"
	.string "What was your name again?\n"
	.string "...{PLAYER}!\p"
	.string "Come on, {PLAYER}.\n"
	.string "Join the show.$"

GoldenrodCity_RadioTower_2F_Text_BuenaEveryoneReady:
	.string "Buena: Everyone ready?\p"
	.string "I want to hear you shout out\n"
	.string "today's password for {PLAYER}!$"

GoldenrodCity_RadioTower_2F_Text_BuenaCorrect:
	.string "Buena: Yippee! That's right!\n"
	.string "You did tune in!\p"
	.string "I'm so happy! You earned one\n"
	.string "point! Congratulations!\p"
	.string "Tune in to my show again\n"
	.string "tomorrow!$"

GoldenrodCity_RadioTower_2F_Text_BuenaWrong:
	.string "Buena: Aww... That's not it...\n"
	.string "Did you forget the password?$"

GoldenrodCity_RadioTower_2F_Text_BuenaOffAir:
	.string "Buena: My password show airs\nevery night, 6 PM to midnight!\p"
	.string "Use your Radio to hear the password,\n"
	.string "then come see me here!$"

GoldenrodCity_RadioTower_2F_Text_BuenaAlreadyPlayed:
	.string "Sorry... You get just one\n"
	.string "chance each day.\p"
	.string "Come back tomorrow for\n"
	.string "another try!$"

GoldenrodCity_RadioTower_2F_Text_BuenaPrizeIntro:
	.string "Buena: You have {STR_VAR_1}P.\n"
	.string "Which prize do you want?$"

GoldenrodCity_RadioTower_2F_Text_BuenaConfirmPrize:
	.string "Buena: Trade {STR_VAR_2}P for\n"
	.string "{STR_VAR_1}?$"

GoldenrodCity_RadioTower_2F_Text_BuenaPrizeGiven:
	.string "Buena: Here you go!\p"
	.string "You have {STR_VAR_1}P left.\p"
	.string "Want another prize?$"

GoldenrodCity_RadioTower_2F_Text_BuenaNotEnoughPoints:
	.string "Buena: You need more points for\n"
	.string "that prize.$"

GoldenrodCity_RadioTower_2F_Text_BuenaBagFull:
	.string "Buena: Your Bag is full.\p"
	.string "Make some room and come back!$"

GoldenrodCity_RadioTower_2F_Text_BuenaAnswerCyndaquil:
	.string "Cyndaquil$"

GoldenrodCity_RadioTower_2F_Text_BuenaAnswerTotodile:
	.string "Totodile$"

GoldenrodCity_RadioTower_2F_Text_BuenaAnswerChikorita:
	.string "Chikorita$"

