mapscripts GoldenrodShore_MapScripts {}

script GoldenrodShore_Expert {
    lock
    faceplayer
    if (flag(FLAG_GOLDENRODSHORE_EXPERT)) {
        setflag(FLAG_GOLDENRODSHORE_EXPERT_QUALIFIED)
        msgbox("Guess I'm free to go home now
                that I no longer have to maintain
                this route expert title.")
        release
        end
    }
    msgbox("Hi! I'm the route expert of local area!

            If you can beat every trainer on routes
            34, 35 and 36. Come have a battle with
            me.")
    if (flag(FLAG_GOLDENRODSHORE_EXPERT_QUALIFIED) || (defeated(TRAINER_SAMUEL) && defeated(TRAINER_BRANDON) && defeated(TRAINER_TODD) && defeated(TRAINER_IAN) && defeated(TRAINER_GINA)
        && defeated(TRAINER_KIM) && defeated(TRAINER_ELLIOT) && defeated(TRAINER_BROOKE) && defeated(TRAINER_IVAN) && defeated(TRAINER_IRWIN) && defeated(TRAINER_WALT) && defeated(TRAINER_ARNIE) && defeated(TRAINER_BRYAN)
        && defeated(TRAINER_MARK) && defeated(TRAINER_ALAN))) {
        setflag(FLAG_GOLDENRODSHORE_EXPERT_QUALIFIED)
        applymovement(LOCALID_GOLDENRODSHORE_EXPERT, Common_Movement_ExclamationMark)
        playse(SE_PIN)
        waitse
        msgbox("I've heard the words of your victories!


                Let's have a battle then, I'll show
                you a new type of strategy!")
        trainerbattle_no_intro(TRAINER_GOLDENROD_SHORE_EXPERT, "Outsmarted!")
        msgbox("Even against my unrelenting tide
                of attacks, you prevailed. 
                
                Please, have this item to boost 
                your odds of keeping up the 
                winning streak.")
        giveitem(ITEM_LOADED_DICE)
        setflag(FLAG_GOLDENRODSHORE_EXPERT)
        addvar(VAR_ROUTE_EXPERTS_DEFEATED, 1)
        special(Achievement_CheckAll)
        msgbox("Loaded Dice boosts the minimum hit 
                count of multi-hit moves, you should 
                try it with moves like Bullet Seed!")        
    }
    release
    end
}

script GoldenrodShore_Sign {
    msgbox("Goldenrod Shore, no littering!", MSGBOX_SIGN)
}

script GoldenrodShore_Engineer {
    msgbox("Alright, time to start digging a path 
            here. The Pokéathlon construction
            starts here!", MSGBOX_NPC)
}

script GoldenrodShore_HiddenGrotto {
    msgbox("There seems to be a path behind the
            trees. Enter?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        warp(MAP_HIDDEN_GROTTO_GOLDENROD_SHORE, 0)
        waitstate
    }
    release
    end
}

script MareaniesGoldenrodShore {
    msgbox("Mareanies seem to be blocking the way.

            Perhaps there is another way to
            the Olivine City?", MSGBOX_NPC)
}
