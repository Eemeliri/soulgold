mapscripts Route50UnderwaterCave2_MapScripts {}

script GroudonEncounter {
    lock
    faceplayer
    bosslegendaryencounter(SPECIES_GROUDON, 80, LOCALID_GROUDON, FLAG_HIDE_GROUDON, 4, SPECIES_NONE, 110, BOSS_PHASE_PROFILE_GROUDON)
    if (var(VAR_RESULT) == B_OUTCOME_CAUGHT) {
        if (!flag(FLAG_GOT_REDORB)) {
            finditem(ITEM_RED_ORB)
            if (var(VAR_0x8007) == TRUE) {
                setflag(FLAG_GOT_REDORB)
            }
        }
        if (!flag(FLAG_ONETIME_GROUDON)) {
            if (var(VAR_POSTGAME_RIVAL_LEGENDARYQ) == 7 || var(VAR_POSTGAME_RIVAL_LEGENDARYQ) == 8) {
                addvar(VAR_POSTGAME_RIVAL_LEGENDARYQ, 1)
            }
            setflag(FLAG_ONETIME_GROUDON)
        }
    }
    release
    end
}
