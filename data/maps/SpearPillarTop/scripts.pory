mapscripts SpearPillarTop_MapScripts {}

script exitPortalSP {
    lock
    warp(MAP_RUINS_OF_ALPH_SECRET_ROOM, 9, 7)
    waitstate
    release
    end
}

script PortalDialga {
    lock
    faceplayer
    msgbox("You gaze deep into the portal.

            It shows you the sea of flowing time.")
    msgbox("Touch the portal?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        bosslegendaryencounter(SPECIES_DIALGA, 85, LOCALID_SPEAR_PILLAR_DIALGA_PORTAL, FLAG_HIDE_SPEAR_PILLAR_DIALGA_PORTAL, 4, SPECIES_NONE, 110, BOSS_PHASE_PROFILE_DIALGA)
        if (var(VAR_RESULT) == B_OUTCOME_CAUGHT) {
            if (!flag(FLAG_GOT_ADAMANT_ORB)) {
                finditem(ITEM_ADAMANT_ORB)
                if (var(VAR_0x8007) == TRUE) {
                    setflag(FLAG_GOT_ADAMANT_ORB)
                }
            }
        }
    }
    release
    end
}

